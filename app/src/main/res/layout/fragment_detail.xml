<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/home_background"
        tools:context=".view.fragment.DetailFragment">

        <include
            android:id="@+id/contentToolbar"
            layout="@layout/toolbar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ScrollView
            android:id="@+id/svDetail"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="96dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/contentToolbar">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingBottom="24dp">

                <!-- Information Card (underneath the photo card) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cvDetailInfo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="112dp"
                    android:layout_marginEnd="20dp"
                    app:cardBackgroundColor="@color/home_card_background"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="3dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="20dp"
                        android:paddingTop="16dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="36dp">

                        <!-- Turn Badge (#1) top-right -->
                        <TextView
                            android:id="@+id/tvDetailTurn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/accent_pink"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            tools:text="# 1" />

                        <!-- Breed Title centered below overlapping photo -->
                        <TextView
                            android:id="@+id/tvDetailBreed"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="124dp"
                            android:gravity="center"
                            android:textColor="@color/black"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            tools:text="pitbull" />

                        <!-- Symptom centered below breed -->
                        <TextView
                            android:id="@+id/tvDetailSymptom"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvDetailBreed"
                            tools:text="Tiene garrapatas" />

                        <!-- Thin Pink Divider below symptom -->
                        <View
                            android:id="@+id/viewDivider"
                            android:layout_width="0dp"
                            android:layout_height="2dp"
                            android:layout_marginTop="8dp"
                            android:background="@color/accent_pink"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvDetailSymptom" />

                        <!-- Owner Row -->
                        <TextView
                            android:id="@+id/tvDetailOwnerLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/detail_owner_label"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/viewDivider" />

                        <TextView
                            android:id="@+id/tvDetailOwner"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp"
                            app:layout_constraintBottom_toBottomOf="@id/tvDetailOwnerLabel"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/tvDetailOwnerLabel"
                            app:layout_constraintTop_toTopOf="@id/tvDetailOwnerLabel"
                            tools:text="Walter" />

                        <!-- Phone Row -->
                        <TextView
                            android:id="@+id/tvDetailPhoneLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="@string/detail_phone_label"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvDetailOwnerLabel" />

                        <TextView
                            android:id="@+id/tvDetailPhone"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp"
                            app:layout_constraintBottom_toBottomOf="@id/tvDetailPhoneLabel"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/tvDetailPhoneLabel"
                            app:layout_constraintTop_toTopOf="@id/tvDetailPhoneLabel"
                            tools:text="3045675518" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.cardview.widget.CardView>

                <!-- Photo Card (overlapping on top of info card with inner margin) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cvDetailPetPhoto"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_marginTop="32dp"
                    app:cardBackgroundColor="@color/home_card_background"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="8dp"
                    app:contentPadding="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/ivDetailPetPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/home_pet_photo_description"
                        android:scaleType="centerCrop"
                        tools:src="@drawable/ic_dog_header_placeholder" />

                </androidx.cardview.widget.CardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </ScrollView>

        <!-- Floating Action Button - Delete (Left) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabDeleteAppointment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginBottom="24dp"
            android:contentDescription="@string/detail_delete_description"
            app:backgroundTint="@color/accent_pink"
            app:elevation="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.DogApp.RoundedFab"
            app:srcCompat="@drawable/ic_delete"
            app:tint="@color/white" />

        <!-- Floating Action Button - Edit (Right) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabEditAppointment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="24dp"
            android:contentDescription="@string/detail_edit_description"
            app:backgroundTint="@color/action_edit_dark_blue"
            app:elevation="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.DogApp.RoundedFab"
            app:srcCompat="@drawable/ic_edit"
            app:tint="@color/white" />

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="@color/accent_pink"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/contentToolbar" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
