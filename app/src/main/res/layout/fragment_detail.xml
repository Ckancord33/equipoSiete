<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/home_background"
        tools:context=".view.fragment.DetailFragment">

        <include
            android:id="@+id/contentToolbar"
            layout="@layout/toolbar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ScrollView
            android:id="@+id/svDetail"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="88dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/contentToolbar">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="16dp"
                android:paddingBottom="24dp">

                <!-- Photo Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cvDetailPetPhoto"
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="6dp"
                    app:cardBackgroundColor="@color/home_card_background"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/ivDetailPetPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/home_pet_photo_description"
                        android:scaleType="centerCrop"
                        tools:src="@drawable/ic_dog_header_placeholder" />

                </androidx.cardview.widget.CardView>

                <!-- Information Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cvDetailInfo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="24dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@color/home_card_background"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/cvDetailPetPhoto">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="20dp">

                        <!-- Turn Badge (#1) -->
                        <TextView
                            android:id="@+id/tvDetailTurn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/accent_pink"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            tools:text="# 1" />

                        <!-- Breed Title -->
                        <TextView
                            android:id="@+id/tvDetailBreed"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:textColor="@color/black"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="@id/tvDetailTurn"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/tvDetailTurn"
                            app:layout_constraintTop_toTopOf="@id/tvDetailTurn"
                            tools:text="Golden Retriever" />

                        <!-- Pink Divider -->
                        <View
                            android:id="@+id/viewDivider"
                            android:layout_width="0dp"
                            android:layout_height="2dp"
                            android:layout_marginTop="12dp"
                            android:background="@color/accent_pink"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvDetailTurn" />

                        <!-- Symptom Row -->
                        <TextView
                            android:id="@+id/tvDetailSymptomLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/detail_symptom_label"
                            android:textColor="@color/text_secondary"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/viewDivider" />

                        <TextView
                            android:id="@+id/tvDetailSymptom"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="16sp"
                            app:layout_constraintBottom_toBottomOf="@id/tvDetailSymptomLabel"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/tvDetailSymptomLabel"
                            app:layout_constraintTop_toTopOf="@id/tvDetailSymptomLabel"
                            tools:text="Fiebre y letargo" />

                        <!-- Owner Row -->
                        <TextView
                            android:id="@+id/tvDetailOwnerLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/detail_owner_label"
                            android:textColor="@color/text_secondary"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvDetailSymptomLabel" />

                        <TextView
                            android:id="@+id/tvDetailOwner"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="16sp"
                            app:layout_constraintBottom_toBottomOf="@id/tvDetailOwnerLabel"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/tvDetailOwnerLabel"
                            app:layout_constraintTop_toTopOf="@id/tvDetailOwnerLabel"
                            tools:text="Juan Perez" />

                        <!-- Phone Row -->
                        <TextView
                            android:id="@+id/tvDetailPhoneLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/detail_phone_label"
                            android:textColor="@color/text_secondary"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvDetailOwnerLabel" />

                        <TextView
                            android:id="@+id/tvDetailPhone"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="16sp"
                            app:layout_constraintBottom_toBottomOf="@id/tvDetailPhoneLabel"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/tvDetailPhoneLabel"
                            app:layout_constraintTop_toTopOf="@id/tvDetailPhoneLabel"
                            tools:text="3001234567" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.cardview.widget.CardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </ScrollView>

        <!-- Floating Action Button - Delete (Left) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabDeleteAppointment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginBottom="24dp"
            android:contentDescription="@string/detail_delete_description"
            app:backgroundTint="@color/accent_pink"
            app:elevation="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:srcCompat="@drawable/ic_delete"
            app:tint="@color/white" />

        <!-- Floating Action Button - Edit (Right) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabEditAppointment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="24dp"
            android:contentDescription="@string/detail_edit_description"
            app:backgroundTint="@color/action_edit_dark_blue"
            app:elevation="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:srcCompat="@drawable/ic_edit"
            app:tint="@color/white" />

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="@color/accent_pink"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/contentToolbar" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
